core:
  registry: workstation.local # scutil --get LocalHostName
  hostname: <server name>
  ssh_keys:
  - ssh-ed25519 AAAA...
  stash:
    key: <LUKS key>
    wipe: true
  data_dir: /var/mnt/stash/data
drives:
- name: stuff
  key: <LUKS key>
  devs:
  - /dev/disk/by-id/disk0
  wipe: true
- name: stuff2
  key: <LUKS key>
  devs:
  - /dev/disk/by-id/disk1
  - /dev/disk/by-id/disk2 # (blockdev --getsize64 <disk>) / 2^20
  size_mib: 65536 # reduce by some margin in case of part variance
  wipe: true
website:
  discord_hook: <secret discord webhook>
forgejo:
  user: dragonlock2
  pass: password
