FROM --platform=linux/amd64 ubuntu:26.04

RUN apt-get update && apt-get -y upgrade
RUN apt-get install -y wget bzip2

WORKDIR /root

# from https://github.com/monero-project/monero/releases (currently v0.18.5.4)
RUN wget -O monerod.tar.bz2 https://downloads.getmonero.org/cli/monero-linux-x64-v0.18.5.4.tar.bz2
RUN tar xvf monerod.tar.bz2 && rm monerod.tar.bz2
RUN mv monero-x86_64-linux-gnu-v0.18.5.4 monero

COPY entry.sh ./

CMD ["/bin/bash", "/root/entry.sh"]
